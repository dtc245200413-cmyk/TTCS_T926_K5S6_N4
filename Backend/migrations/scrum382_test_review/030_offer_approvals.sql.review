-- REVIEW ONLY (5.2C). Not executed, not registered with Backend startup.
-- Apply only after explicit approval, verified TEST backup/restore and preflight.
-- All SQL objects are qualified to internal_recruitment_test; never use --force.
-- A failed/partial step requires inventory and review, NOT a blind rerun.
SELECT DATABASE() AS selected_database, CURRENT_USER() AS account,
       VERSION() AS mysql_version;
-- Operator STOP unless database is exactly internal_recruitment_test and the
-- approved dedicated migration account is in use (never root/scrum103_reader).

-- Precondition: table absent; step 020 complete.
-- Shared SCRUM-390/391 schema, including action spelling REQUEST_CHANGE.
-- Preserve source database.sql delete semantics: Offer CASCADE, approver RESTRICT.
-- CASCADE retention risk requires owner review before applying; do not silently
-- reinterpret action history as approval assignments or change runtime approval.
CREATE TABLE internal_recruitment_test.offer_approvals (
  id INT AUTO_INCREMENT PRIMARY KEY,
  offer_id INT NOT NULL,
  approver_id INT NOT NULL,
  action ENUM('APPROVED','REJECTED','REQUEST_CHANGE') NOT NULL,
  reason TEXT NULL,
  action_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_oa_offer (offer_id, action_at),
  CONSTRAINT fk_oa_offer FOREIGN KEY (offer_id) REFERENCES internal_recruitment_test.candidate_offers(id) ON DELETE CASCADE,
  CONSTRAINT fk_oa_approver FOREIGN KEY (approver_id) REFERENCES internal_recruitment_test.users(user_id) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
SHOW CREATE TABLE internal_recruitment_test.offer_approvals;
