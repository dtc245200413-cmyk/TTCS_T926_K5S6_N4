# Cấu hình MySQL: thay bằng thông tin trên máy của bạn; không dùng mật khẩu thật trong file mẫu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=internal_recruitment_system

PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# Email (chỉ cần khi dùng chức năng gửi mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
